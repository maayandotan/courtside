{
  "name": "courtside",
  "version": "0.4.1",
  "private": true,
  "description": "Desktop shell that unifies sports streaming across NBA, Premier League, Champions League, NFL and EuroLeague, with multi-view and spoiler-safe skip to quarter.",
  "author": "Maayan Dotan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maayandotan/courtside.git"
  },
  "keywords": [
    "electron",
    "sports",
    "streaming",
    "multi-view",
    "widevine",
    "nba",
    "premier-league",
    "nfl"
  ],
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir --mac",
    "sign:vmp": ".evs-venv/bin/evs-vmp sign-pkg dist/mac-arm64",
    "sign:codesign": "codesign --deep --force --sign - dist/mac-arm64/CourtSide.app",
    "build:mac": "npm run pack && npm run sign:vmp && npm run sign:codesign",
    "open": "open dist/mac-arm64/CourtSide.app"
  },
  "devDependencies": {
    "electron": "github:castlabs/electron-releases#v44.1.0+wvcus",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.courtside.app",
    "productName": "CourtSide",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "mac": {
      "identity": null,
      "icon": "build/icon.icns"
    }
  }
}
